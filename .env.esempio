# Copiare in .env e valorizzare. Il file .env non va versionato.

# Stringa di connessione a MongoDB
MONGO_URL=mongodb://localhost:27017/aulalibera

# Segreto per la firma dei token JWT: in produzione va generato casualmente
JWT_SEGRETO=sviluppo-non-usare-in-produzione

# Durata dei token emessi al login
JWT_SCADENZA=8h

# Porta di ascolto del server
PORTA=3000
